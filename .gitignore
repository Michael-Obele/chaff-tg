# Planning material stays local: it travels with this machine, not with git.
# The plan lives in plan/ and is deliberately untracked (see plan/README.md).
plan/

# The teaching workspace for this repo (teach/MISSION.md). Same rule as plan/:
# a working aid for me, so it stays local and out of the history.
teach/

# A leaked session file is a leaked Telegram account. Never commit it.
*.session
*.session-shm
*.session-wal
*.session.json

# The app credentials are a secret too: `.env` holds the api hash, and a copy of
# the config (which `chaff login` writes to ~/.config/chaff-tg/) must not land in
# a commit either. The template is the one exception.
.env
.env.*
!.env.example
/config.json

# Build and dependency output
dist/
# Release staging: the artifacts the release job collects before upload
.chaff-release/
node_modules/
*.tsbuildinfo

# Editor and OS noise
.DS_Store
*.log

# Local agent/tooling state and scratch files
.superpowers/
cleanup.md
