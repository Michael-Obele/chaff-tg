# Copy this file to `.env` **inside `web/`** and fill in your own values:
#
#   cp web/.env.example web/.env
#
# `web/.env` is gitignored: it holds the api hash and the login password.
# Nothing here is ever sent to a server of ours — the values below are either
# inlined into the bundle at build time or used by the local login gate.

# ---------------------------------------------------------------------------
# Telegram app credentials (required)
#
# Both come from https://my.telegram.org/apps
# (see the Setup section of ../README.md for the form, field by field).
#
# These are inlined into the shipped JavaScript by `vite.config.ts`, because the
# browser talks to Telegram directly over `@mtcute/web`. Accepted because this
# deployment is single-user; mtcute's own docs warn the hash cannot be revoked.
# ---------------------------------------------------------------------------

# The app id, a number.
CHAFF_API_ID=

# The app hash, 32 hex characters.
CHAFF_API_HASH=

# ---------------------------------------------------------------------------
# The login gate (Better Auth)
#
# Sign-up is disabled, so these are the only credentials that ever work. Better
# Auth signs in by email, which is why the username is an email address.
# On Netlify these same names go in the site's environment variables.
# ---------------------------------------------------------------------------

# The single account this site accepts.
CHAFF_APP_EMAIL=
CHAFF_APP_PASSWORD=

# Secret used to sign the session cookie. Generate one, do not invent one:
#
#   openssl rand -base64 32
#
BETTER_AUTH_SECRET=

# Public URL of the deployed site, with no trailing slash.
# Local development: http://localhost:5173
BETTER_AUTH_URL=

# A database for Better Auth's `user` and `session` rows. Without it the login
# route fails at runtime. Postgres URL, e.g.
# postgres://user:pass@host:5432/chaff
DATABASE_URL=

# ---------------------------------------------------------------------------
# Using the CLI as well
#
# The CLI reads `CHAFF_API_ID` / `CHAFF_API_HASH` from the **repo-root** `.env`
# (Bun loads `.env` from the working directory). To share these two values:
#
#   cp web/.env.example .env
#
# Or skip the file entirely — `chaff login` asks for both values itself.
# ---------------------------------------------------------------------------

