# Copy this file to `.env` and fill in your own two values:
#
#   cp .env.example .env
#
# Bun loads `.env` from the working directory, for `bun run src/cli/index.ts` and
# for a compiled binary alike, so nothing has to be exported. `.env` is
# gitignored on purpose: the api hash is a secret.
#
# Both values come from https://my.telegram.org/apps
# (see the Setup section of README.md for the form, field by field).

# The app id, a number.
CHAFF_API_ID=

# The app hash, 32 hex characters. Keep it out of git, out of screenshots, and
# out of bug reports.
CHAFF_API_HASH=

# Optional: run against the fake client, with no account and no network, to try
# the commands out. `chaff login` under this writes a marker instead of a real
# session.
# CHAFF_FAKE=1
